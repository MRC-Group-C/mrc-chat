# =============================================================================
# MRC-CHAT DEPLOYMENT ENVIRONMENT VARIABLES (.env.example)
# Location: mrc/deploy/.env.example
# Security Rule: Do NOT commit production .env into Git. Copy to .env on deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. THIẾT LẬP MẠNG & TÊN MIỀN HỆ THỐNG (NETWORK & DOMAIN)
# -----------------------------------------------------------------------------
# URL gốc truy cập Rocket.Chat (khớp với tên miền Caddy reverse proxy)
ROOT_URL=https://chat.miraclegroup.vn
PORT=3000
BIND_IP=127.0.0.1
SITE_NAME="Chat Miracle"

# -----------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU MONGODB 8.0 REPLICA SET (DATABASE)
# -----------------------------------------------------------------------------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=rocketchat
MONGO_REPLICA_SET_NAME=rs0

# Chuỗi kết nối ứng dụng và oplog
MONGO_URL=mongodb://mongodb:27017/rocketchat?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://mongodb:27017/local?replicaSet=rs0

# -----------------------------------------------------------------------------
# 3. TÍCH HỢP XÁC THỰC KEYCLOAK OIDC (CUSTOM OAUTH)
# -----------------------------------------------------------------------------
KC_AUTH_URL=https://sso.miraclegroup.vn/realms/mrc/protocol
# Trong môi trường local dev (Docker), container cần truy cập Keycloak qua host.docker.internal:
# KC_TOKEN_PATH=http://host.docker.internal:8080/realms/mrc/protocol/openid-connect/token
# KC_IDENTITY_PATH=http://host.docker.internal:8080/realms/mrc/protocol/openid-connect/userinfo
KC_CLIENT_ID=chat-miracle
# Khóa bí mật client OIDC (phải khớp client secret trong miracle-sso/keycloak/import/mrc-realm.json)
KC_CLIENT_SECRET=change_this_to_strong_client_secret_2026!

# -----------------------------------------------------------------------------
# 4. TÀI KHOẢN CỨU HỘ CỤC BỘ (EMERGENCY RESCUE ADMIN - SEC-CHT-03)
# -----------------------------------------------------------------------------
# Tài khoản dự phòng trường hợp Keycloak gặp sự cố; không tạo trên Keycloak
ADM_LOCAL_USERNAME=adm-local-chat
ADM_LOCAL_PASSWORD=ReplaceWithStrong24CharsPasswordInKeePass!
ADM_LOCAL_EMAIL=it-admin-rescue@miraclegroup.vn

# -----------------------------------------------------------------------------
# 5. TÀI KHOẢN DỊCH VỤ ĐỒNG BỘ (PROVISIONING BOT SVC-RC-SYNC)
# -----------------------------------------------------------------------------
SVC_RC_SYNC_USERNAME=svc-rc-sync
SVC_RC_SYNC_ROLE=mrc-provisioner

# -----------------------------------------------------------------------------
# 6. THIẾT LẬP SAO LƯU DỮ LIỆU MONGODB (BACKUP CONFIGURATION)
# -----------------------------------------------------------------------------
BACKUP_DIR=/backup/mongodb
RETENTION_DAYS=7
